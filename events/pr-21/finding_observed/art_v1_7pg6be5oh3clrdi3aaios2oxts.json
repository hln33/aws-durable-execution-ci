{"data":{"body":"[P2] Pass the configuration path as a subprocess argument. Interpolating `path` into a shell command splits filenames containing spaces, so Git can return an unrelated revision or no revision. Shell metacharacters in filenames can also execute commands. Pass an argument list with the shell disabled so Git receives the path intact.","comment_node_id":"","finding_digest":"89c7a7364139c2100ac376a782aac79874e3a35cd0c0ffcf32fbc62cf0fd4dc1","finding_id":"arf_v1_rhd2onsbhhbbacwdo2tyfkwhtb","finding_key":"scripts/smoke_load_review_config.py::resolve_config_revision::shell-interprets-config-path","identity_key":"scripts/smoke_load_review_config.py::resolve_config_revision::shell-interprets-config-path","line":26,"observation_digest":"57cb01e3cbeaa7b843815b802391b69e4344cee8225f1d452058a6a53961fd87","observation_id":"aro_v1_k7fqdy6l5kt3qq4bloachenwtz","path":"scripts/smoke_load_review_config.py","prior_finding_id":"arf_v1_rhd2onsbhhbbacwdo2tyfkwhtb","published_at":"2026-10-15T22:15:27Z","review_id":"arr_v1_wlpwwv7disu2bljicpuqmabjsx","reviewed_base_sha":"614d1e54eb63e535fd6c257876ea7e68a925e32c","reviewed_head_sha":"19254f08329da65239c92557bcf73f47ce8ba234","reviewer":"codex","start_line":23,"suggestion_id":"","suppressed":true,"suppression_status":"false-positive"},"pull_request":{"number":21},"record_id":"art_v1_7pg6be5oh3clrdi3aaios2oxts","record_type":"finding_observed","recorded_at":"2026-10-15T22:15:27Z","repository":{"full_name":"hln33/aws-durable-execution-ci","id":1338910461},"schema_version":1}
