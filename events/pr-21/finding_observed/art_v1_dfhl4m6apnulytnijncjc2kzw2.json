{"data":{"body":"`resolve_config_revision` interpolates the caller-supplied `path` directly into a shell command string and executes it with `subprocess.run(command, shell=True, ...)`. Any path containing shell metacharacters (e.g. `; rm -rf .`, backticks, `$( )`, `|`) is executed as part of the shell invocation, giving arbitrary command execution (CWE-78). Build the argv list explicitly and drop `shell=True` so the path is always treated as a single literal argument.","comment_node_id":"PRRC_kwDOT84m_c7_oeyi","finding_digest":"c8ab5cb145bfe1f315578a70ec5952edbd2dbed9cb78b9ab102771600eb13307","finding_id":"arf_v1_zcvvzmkfx7q7gfkxrjyoywks5w","finding_key":"scripts/smoke_load_review_config.py::resolve_config_revision::shell-command-injection","identity_key":"scripts/smoke_load_review_config.py::resolve_config_revision::shell-command-injection","line":31,"observation_digest":"742d0cb52a7855196eb7ddebdba574037297ee676b3d999db724a9a685a27e76","observation_id":"aro_v1_oqwqznjkpbkrs3vx3xv5xjluan","path":"scripts/smoke_load_review_config.py","prior_finding_id":"","published_at":"2026-10-15T22:12:36Z","review_id":"arr_v1_uqtwt6u2tkhz2edctlnn4eol6y","reviewed_base_sha":"614d1e54eb63e535fd6c257876ea7e68a925e32c","reviewed_head_sha":"19254f08329da65239c92557bcf73f47ce8ba234","reviewer":"claude","start_line":23,"suggestion_id":"arsg_v1_pcna7tizh6k64v2rqxnwvpj4r7"},"pull_request":{"number":21},"record_id":"art_v1_dfhl4m6apnulytnijncjc2kzw2","record_type":"finding_observed","recorded_at":"2026-10-15T22:12:36Z","repository":{"full_name":"hln33/aws-durable-execution-ci","id":1338910461},"schema_version":1}
