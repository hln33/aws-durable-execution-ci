{"data":{"body":"[P2] Use a supported YAML loader. PyYAML 6.x requires the `Loader` argument for `yaml.load`, so every readable configuration raises `TypeError` here before the script prints its results. Use `yaml.safe_load` to parse configuration data without enabling arbitrary Python object construction.","comment_node_id":"PRRC_kwDOT84m_c7_ocrX","finding_digest":"678341ddf03bff9462ae71796f17d68f89460993e72bd3085ca83f7382cd5391","finding_id":"arf_v1_m6budxpqhp7ziyvoof4w6f6wr6","finding_key":"scripts/smoke_load_review_config.py::load_review_config::missing-yaml-loader","identity_key":"scripts/smoke_load_review_config.py::load_review_config::missing-yaml-loader","line":18,"observation_digest":"cc452fbd7c6762a24418a621997a2adb271763ae20e4d5243928f7af071292f9","observation_id":"aro_v1_zrcs7pl4m5rkerayuyqzs6rk3m","path":"scripts/smoke_load_review_config.py","prior_finding_id":"","published_at":"2026-10-15T22:11:23Z","review_id":"arr_v1_icrkxg6dcidrtevfavtpfoiy6j","reviewed_base_sha":"614d1e54eb63e535fd6c257876ea7e68a925e32c","reviewed_head_sha":"19254f08329da65239c92557bcf73f47ce8ba234","reviewer":"codex","start_line":18,"suggestion_id":"arsg_v1_uq5w36sz65aojsx7wu6hzywp7d"},"pull_request":{"number":21},"record_id":"art_v1_fhe2wubxwmko3qsogykpx3rely","record_type":"finding_observed","recorded_at":"2026-10-15T22:11:23Z","repository":{"full_name":"hln33/aws-durable-execution-ci","id":1338910461},"schema_version":1}
