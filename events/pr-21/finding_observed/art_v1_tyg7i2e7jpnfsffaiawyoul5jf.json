{"data":{"body":"[P2] Pass the configuration path as a subprocess argument. Interpolating `path` into a shell command splits filenames containing spaces, causing Git to return an unrelated revision or no revision. Shell metacharacters in filenames can also execute commands. Pass an argument list with the shell disabled so the path reaches Git intact.","comment_node_id":"PRRC_kwDOT84m_c7_ocup","finding_digest":"89c7a7364139c2100ac376a782aac79874e3a35cd0c0ffcf32fbc62cf0fd4dc1","finding_id":"arf_v1_rhd2onsbhhbbacwdo2tyfkwhtb","finding_key":"scripts/smoke_load_review_config.py::resolve_config_revision::shell-interprets-config-path","identity_key":"scripts/smoke_load_review_config.py::resolve_config_revision::shell-interprets-config-path","line":26,"observation_digest":"41360889d32a79c07e3be2ba1335028225d03f104106546e7c934fe95276a117","observation_id":"aro_v1_ie3arcotfj44a7r34k5bgnicqi","path":"scripts/smoke_load_review_config.py","prior_finding_id":"","published_at":"2026-10-15T22:11:24Z","review_id":"arr_v1_icrkxg6dcidrtevfavtpfoiy6j","reviewed_base_sha":"614d1e54eb63e535fd6c257876ea7e68a925e32c","reviewed_head_sha":"19254f08329da65239c92557bcf73f47ce8ba234","reviewer":"codex","start_line":23,"suggestion_id":"arsg_v1_kutnblgfa6ny2a7j72fhhizp7q"},"pull_request":{"number":21},"record_id":"art_v1_tyg7i2e7jpnfsffaiawyoul5jf","record_type":"finding_observed","recorded_at":"2026-10-15T22:11:24Z","repository":{"full_name":"hln33/aws-durable-execution-ci","id":1338910461},"schema_version":1}
